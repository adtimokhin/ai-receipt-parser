# Copy to .env and adjust. All variables use the APP_ prefix.

APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO
APP_JSON_LOGS=true
APP_SERVICE_NAME=receipt-parser-backend

# --- db_mongodb ---
APP_DB_MONGODB_URI=mongodb://mongodb:27017
APP_DB_MONGODB_DATABASE=receipt-parser-backend
APP_DB_MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000

# --- llm_openai ---
APP_LLM_OPENAI_API_KEY=
APP_LLM_OPENAI_MODEL=gpt-4o-mini
APP_LLM_OPENAI_TIMEOUT_S=30
# APP_LLM_OPENAI_BASE_URL=

# --- blob_storage ---
# Local dev points at minio. In prod, point these at Cloudflare R2's S3
# endpoint (https://<account_id>.r2.cloudflarestorage.com) with an R2 API
# token's access/secret key.
APP_BLOB_STORAGE_ENDPOINT_URL=http://minio:9000
APP_BLOB_STORAGE_ACCESS_KEY=minioadmin
APP_BLOB_STORAGE_SECRET_KEY=minioadmin
APP_BLOB_STORAGE_BUCKET=receipt-parser-backend
APP_BLOB_STORAGE_REGION=us-east-1

# --- telegram ---
APP_TELEGRAM_BOT_TOKEN=
# Sent by Telegram on every webhook call as X-Telegram-Bot-Api-Secret-Token;
# set the same value with setWebhook's secret_token parameter.
APP_TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user IDs allowed to use the bot.
APP_TELEGRAM_WHITELIST=

# --- llamaextract ---
APP_LLAMAEXTRACT_API_KEY=

